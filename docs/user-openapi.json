        "type": "object"
      },
      "Alert": {
        "title": "Alert",
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "productId",
          "userId"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },

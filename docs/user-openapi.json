          }
        }
      },
      "Instructor": {
        "title": "Instructor",
        "type": "object"
      },
      "NotFound": {
        "title": "NotFound",
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
